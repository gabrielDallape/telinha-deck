      "botao": {
        "aparencia": {
          "widget": "icone",
          "icon": "volume",
          "label": "Som",
          "label_on": "Mudo",
          "color": "#5B6572",
          "nivel_de": "sys_vol"
        },
        "toque": [
          {
            "type": "sys_mute_toggle"
          }
        ],
        "aceso": "sys_muted"
      },
      "icone": "volume"
