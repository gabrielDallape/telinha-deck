        "exigir": {
          "tipo": "bool",
          "rotulo": "Avisar se o app estiver fechado",
          "padrao": true
        }
      }
    },
    "digitar": {
      "rotulo": "Digitar no terminal do Claude",
      "campos": {
        "texto": {
          "tipo": "texto",
          "rotulo": "Texto"
